# ==============================================================================
# ToolGhor Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local (for Next.js development) and fill in the values.
# NEVER commit .env or .env.local to source control.

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
DATABASE_URL="postgres://username:password@hostname:5432/toolghor?sslmode=require"
# POSTGRES_URL is also accepted as fallback:
# POSTGRES_URL="postgres://username:password@hostname:5432/toolghor?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Cryptographic Security Secrets
# ------------------------------------------------------------------------------
# High-entropy random secret used for keyed HMAC digests of OTPs and reset tokens.
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# ------------------------------------------------------------------------------
# 3. Email Provider (Choose Resend API OR SMTP)
# ------------------------------------------------------------------------------
# The 'From' sender address (must be a verified domain/address on your provider)
EMAIL_FROM="ToolGhor Security <noreply@toolghor.com>"

# --- Option A: Resend (Recommended for Next.js / Vercel) ---
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=""

# --- Option B: SMTP (e.g. Gmail App Password, Mailgun, Brevo, AWS SES) ---
# For Gmail: Use smtp.gmail.com, port 587 (or 465), your Gmail address, and a 16-character App Password
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 4. Optional Security Policy Configuration (Defaults shown below)
# ------------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=5
RESET_TOKEN_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 5. External Tools & APIs
# ------------------------------------------------------------------------------
# ConvertAPI token: https://www.convertapi.com/a
CONVERTAPI_TOKEN=""

# Remove.bg API key
REMOVEBG_API_KEY=""

# OpenAI / Gemini API keys for AI Assistant & Resume Builder
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Development Server Port
PORT=8000
